﻿<h1>Api Departamentos Cliente</h1>

@section Scripts {
    <script>
        let url = "https://apicorecruddepartamentosmmt.azurewebsites.net/";
        $(document).ready(function(){
            loadDepts();
            $("#btnpost").click(function (){
                let id = $("#cajaid").val();
                let nombre = $("#cajanombre").val();
                let localidad = $("#cajalocalidad").val();

                let dept = new Object();
                dept.idDepartamento = parseInt(id);
                dept.nombre = nombre;
                dept.localidad = localidad;

                var json = JSON.stringify(dept);
                let request = "api/departamentos";
                $.ajax({
                    url: url + request,
                    method: "POST",
                    data: json,
                    contentType: "application/json",
                    success: function(data){
                        console.log("posted");
                        loadDepts();
                    }
                })
            })

            $("#btnput").click(function (){
                let id = $("#cajaid").val();
                let nombre = $("#cajanombre").val();
                let localidad = $("#cajalocalidad").val();

                let dept = new Object();
                dept.idDepartamento = parseInt(id);
                dept.nombre = nombre;
                dept.localidad = localidad;

                var json = JSON.stringify(dept);
                let request = "api/departamentos";
                $.ajax({
                    url: url + request,
                    method: "PUT",
                    data: json,
                    contentType: "application/json",
                    success: function(data){
                        console.log("puted");
                        loadDepts();
                    }
                })
            })

            $("#btndelete").click(function (){
                let id = $("#cajaid").val();

                let request = "api/departamentos/" + id;
                $.ajax({
                    url: url + request,
                    method: "DELETE",
                    success: function(data){
                        console.log("deleted");
                        loadDepts();
                    }
                })
            })
        })

        

    </script>
}

<form>
    <label>Id Dept</label>
    <input type="text" id="cajaid" class="form-control"/>
    <br/>
    <label>Nombre</label>
    <input type="text" id="cajanombre" class="form-control" />
    <br />
    <label>Localidad</label>
    <input type="text" id="cajalocalidad" class="form-control" />
    <br />
    <button id="btnpost" type="button" class="form-control" style="background-color:lightcyan">Post</button>
    <button id="btnput" type="button" class="form-control" style="background-color:lightcyan">Put</button>
    <button id="btndelete" type="button" class="form-control" style="background-color:lightcyan">Delete</button>
    <br/>
</form>

<table id="tabladepts" class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Localidad</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>