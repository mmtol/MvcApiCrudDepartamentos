@model IEnumerable<MvcApiCrudDepartamentos.Models.Departamento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-controller="Departamentos" asp-action="Post">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdDepartamento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Localidad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdDepartamento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Localidad)
            </td>
            <td>
                <a asp-controller="Departamentos" asp-action="Details" asp-route-iddepartamento=@item.IdDepartamento>Details</a>
                    <a asp-controller="Departamentos" asp-action="Put" asp-route-iddepartamento=@item.IdDepartamento>Put</a>
                    <a asp-controller="Departamentos" asp-action="Delete" asp-route-iddepartamento=@item.IdDepartamento>Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
